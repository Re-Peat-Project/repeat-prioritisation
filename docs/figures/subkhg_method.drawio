<mxfile host="repeat-prioritisation"><diagram id="subkhg" name="Sub-KHG prioritisation"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Sub-KHG prioritisation, RE-PEAT: method of 2026-10-26 (repeat-prioritisation, subkhg)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Per KHG:&lt;/b&gt; python -m subkhg.run --config re-peat/sites/&amp;lt;khg&amp;gt;/subkhg.yaml (--fetch-only once for the cloud layers, then --skip-fetch). Order: KHG inputs → DTM (repeat-dem) → sub-KHG units (repeat-delineation) → neraca air (repeat-neraca) → this ranking → repeat-pump." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="INPUTS" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="88" width="360" height="24" as="geometry"/></mxCell><mxCell id="c5" value="PROCESSING" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="88" width="360" height="24" as="geometry"/></mxCell><mxCell id="c6" value="OUTPUTS  (_khg/&amp;lt;khg&amp;gt;/04_prioritisation/)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="88" width="360" height="24" as="geometry"/></mxCell><mxCell id="c7" value="USED BY" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="88" width="230" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Ranking of the sub-KHG of one KHG by need for rewetting intervention" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="115" width="1510" height="690" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Sub-KHG units&lt;/b&gt; 02_delineation/subkhg_units.gpkg (repeat-delineation)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="370" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;National layers&lt;/b&gt; (_data, as the national profile)&lt;br&gt;• burnt-area polygons 2015-2026 (KLHK)&lt;br&gt;• VIIRS hotspots 2012-2025 (type 0, confidence n/h)&lt;br&gt;• KLH hotspots 2026 (medium, high)&lt;br&gt;• canals with KODE_KANAL · GFW peat extent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="199" width="370" height="104" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;KHG vectors&lt;/b&gt; (00_inputs, clipped from _data)&lt;br&gt;canals (reach, blocks needed), rivers, existing canal blocks&lt;br&gt;FEG 2017 protected function (landstatus)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="311" width="370" height="62" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Rasters&lt;/b&gt; DTM (slope, lift) · peat depth model" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="381" width="370" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Cloud&lt;/b&gt; (Planetary Computer)&lt;br&gt;Sentinel-2 L2A NDMI/NDVI, Aug-Oct median, 20 m&lt;br&gt;ESA WorldCover (forest) · JRC water seasonality" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="435" width="370" height="62" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;SiTMAT&lt;/b&gt; stations 2026 (days deeper than 0.4 m, recession)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="505" width="370" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;repeat-neraca&lt;/b&gt;&lt;br&gt;neraca_balance_unit.csv (P − ET, balance_stable_ok)&lt;br&gt;neraca_khg.csv (KHG deficit)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="559" width="370" height="62" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;1. Fire and canals per unit&lt;/b&gt; (subkhg.national_layers → national.profile.build_profile)&lt;br&gt;burnt share per year and repeat burns, hotspots, this year's hotspots, canal km per km² by class; rates per km² of peat; held-out targets v_burned_frac, v_hotspot" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="430" y="199" width="440" height="104" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;2. Indicators on a 30 m grid&lt;/b&gt; (common.indicators)&lt;br&gt;• NDMI, NDVI: median of Aug-Oct composites, mean over the years&lt;br&gt;• reach: share within 200 m of a canal (60 m on burnt land)&lt;br&gt;• missing blocks (IPG): 1 − existing / needed; spacing 0.4 m ÷ canal slope&lt;br&gt;• distance to dry-season water, lift above it (DTM)&lt;br&gt;• peat depth, forest share, protected share, SiTMAT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="430" y="311" width="440" height="150" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;3. Merge neraca air&lt;/b&gt; (extra_indicators): P − ET for the rank-sum water slot; empty where balance_stable_ok = 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="430" y="469" width="440" height="62" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;4. Score&lt;/b&gt; (subkhg.prioritise)&lt;br&gt;• each indicator scaled 0-1 between its 5th and 95th percentile within the KHG, direction applied&lt;br&gt;• urgency U and stakes S: weighted means of the available indicators&lt;br&gt;• &lt;b&gt;need = 0.8 U + 0.2 S&lt;/b&gt;; feasibility reported, not ranked&lt;br&gt;• classes: tertiles of need (tinggi, sedang, rendah)&lt;br&gt;• rank-sum (team's earlier method) computed alongside" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="430" y="539" width="440" height="130" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;5. Checks&lt;/b&gt;&lt;br&gt;• indicator pairs with Spearman above 0.8 flagged&lt;br&gt;• weight sensitivity: 300 Dirichlet draws around the weights&lt;br&gt;• held-out validation (scripts/validate_subkhg.py): indicators 2015-2018 → fire 2019; 2015-2022 → fire 2023; Spearman with bootstrap interval, against fire history alone" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="430" y="677" width="440" height="118" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Weights&lt;/b&gt; (provisional, not agreed with the team)&lt;br&gt;Urgency U: burnt share 2 · repeat burns 1 · hotspots 1 · hotspots this year 1 · NDMI 1 · canals primary 0.5, secondary 0.3, tertiary 0.2 · missing blocks 1.5 · reach 1.5 · distance to water 1 · forest share 1 (less forest, more need) · SiTMAT 1 + 1 (only with enough stations)&lt;br&gt;Stakes S: peat depth 2 · protected function 1&lt;br&gt;Weight 0: NDVI, neraca balance, single canal density (replaced by classes)&lt;br&gt;Reported only: lift, rates per area&lt;br&gt;An indicator is scored when at least min(20, n/2) units have a value" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f3f3f3;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="145" width="590" height="205" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;unit_prioritas.gpkg / .csv&lt;/b&gt;: every indicator, normalised values, skor_urgensi, skor_dampak, skor_need, kelas, peringkat; rank-sum and its rank; sensitivity p_prioritas1&lt;br&gt;&lt;b&gt;laporan.json&lt;/b&gt;: weights, coverage, correlations, sensitivity, validation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="920" y="360" width="350" height="125" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;subkhg_priority.csv&lt;/b&gt;: unit_id, priority_rank, deficit_mm (KHG deficit), design_period_days" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="920" y="495" width="350" height="62" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;reports&lt;/b&gt;: run report (subkhg.report), map page (subkhg.dashboard), validation (re-peat/reports/subkhg_validation.md)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="920" y="567" width="350" height="62" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;repeat-pump&lt;/b&gt; (contract C6): canal blocks and pumping order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5ecf7;strokeColor=#8a5a9c;" vertex="1" parent="1"><mxGeometry x="1280" y="495" width="230" height="62" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Team&lt;/b&gt;: choice of sub-KHG, weights (AHP session)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5ecf7;strokeColor=#8a5a9c;" vertex="1" parent="1"><mxGeometry x="1280" y="567" width="230" height="62" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Validation, 2026-10-26&lt;/b&gt; (Spearman with burned share in the test year, 26-30 units)&lt;br&gt;Kampar-Gaung 2019 / 2023: need 0.61 / 0.29 · urgency 0.57 / 0.30 · fire history alone 0.38 / 0.22 · rank-sum 0.66 / 0.47&lt;br&gt;Sugihan-Lumpur 2019 / 2023: need 0.37 / 0.17 · urgency 0.54 / 0.30 · fire history alone 0.64 / 0.36 · rank-sum 0.25 / 0.10&lt;br&gt;Intervals overlap: no score clearly better. Stakes lower the fire prediction by design; drainage indicators are not testable against fire. Weights need the team (AHP), with this as a check." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f3f3f3;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="640" width="590" height="155" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c9" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c9" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c11" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;dashed=1;" edge="1" parent="1" source="c21" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="What changed from the team's earlier method (slide 'Contoh Parameter Penentuan Prioritas Pembasahan dalam 1 KHG', Kahayan-Sebangau)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="820" width="1510" height="230" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Earlier method (kept as the rank-sum)&lt;/b&gt;&lt;br&gt;• 8 indicators ranked, ranks summed, equal weights&lt;br&gt;• NDMI, NDVI, peat depth, water decline, water balance, deficit months, dry days, hotspot count&lt;br&gt;• climate indicators at 4-25 km, nearly constant inside a KHG&lt;br&gt;• no check against later fire" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fdf3e7;strokeColor=#b07a2a;" vertex="1" parent="1"><mxGeometry x="30" y="850" width="470" height="190" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Now&lt;/b&gt;&lt;br&gt;• Need score: magnitudes scaled within the KHG, explicit weights, urgency and stakes separate, feasibility reported&lt;br&gt;• Fire and canals from the same national layers and code as the national profile, per km² of peat; repeat burns and this year's hotspots added; canals by class&lt;br&gt;• Drainage: canal reach and missing blocks (IPG metric) from the canal layer, DTM and existing blocks&lt;br&gt;• Climate: dry days and TerraClimate dropped (cannot separate sub-KHG); water balance from repeat-neraca, used only where its order is trustworthy&lt;br&gt;• NDMI at Sentinel-2's native 20 m; FEG protected function in the stakes&lt;br&gt;• Held-out validation on two El Nino years, compared with fire history alone" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e9f3fb;strokeColor=#2f6f9f;" vertex="1" parent="1"><mxGeometry x="520" y="850" width="990" height="190" as="geometry"/></mxCell><mxCell id="c49" value="extended" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
